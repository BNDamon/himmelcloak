# Himmelcloak CI image for RHEL-compatible and Fedora distributions; published by publish-ci-image.yml.
# Install system dependencies here, never in workflows.
ARG BASE=rockylinux:9
FROM ${BASE}

RUN dnf -y --setopt=install_weak_deps=False install --allowerasing \
    autoconf automake ca-certificates clang clang-devel cmake curl gawk gcc gcc-c++ git gzip \
    libtool make perl pkgconf-pkg-config tar \
    && dnf clean all

ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:${PATH}
RUN curl --proto '=https' --tlsv1.2 -sSfo /tmp/rustup-init \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
    && echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.95.0 \
        --component clippy,rustfmt \
    && rm /tmp/rustup-init

COPY scripts/build-native.sh /usr/local/bin/himmelcloak-build-native
ARG WOLFSSL_REF=v5.9.2-stable
ARG CURL_REF=curl-8_22_0
WORKDIR /tmp/himmelcloak-build
# This GCC does not default to PIE, but Rust links PIE executables against these archives.
RUN CFLAGS=-fPIC WOLFSSL_REF="$WOLFSSL_REF" CURL_REF="$CURL_REF" \
    NATIVE_PREFIX=/opt/himmelcloak-native himmelcloak-build-native

# These distributions keep libclang in /usr/lib64, outside bindgen's default search path.
ENV LIBCLANG_PATH=/usr/lib64
ENV WOLFSSL_PREFIX=/opt/himmelcloak-native
ENV PKG_CONFIG_PATH=/opt/himmelcloak-native/lib/pkgconfig
ENV PKG_CONFIG_ALL_STATIC=1
ENV LD_LIBRARY_PATH=/opt/himmelcloak-native/lib
ENV PATH=/opt/himmelcloak-native/bin:${PATH}
WORKDIR /work
