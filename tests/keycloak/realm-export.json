{
  "realm": "himmelcloak-test",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "accessCodeLifespan": 10,
  "clients": [
    {
      "clientId": "himmelcloak-test-client",
      "name": "Himmelcloak integration tests",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:8845/himmelcloak/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:8845"
      ]
    },
    {
      "clientId": "himmelcloak-browser-only",
      "name": "Himmelcloak browser-flow tests without the password grant",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8845/himmelcloak/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:8845"
      ]
    },
    {
      "clientId": "himmelcloak-webauthn",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8845/himmelcloak/callback"
      ],
      "authenticationFlowBindingOverrides": {
        "browser": "fixture-webauthn"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Test",
      "email": "alice@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "correct-horse-battery-staple",
          "temporary": false
        }
      ]
    },
    {
      "username": "passkey-test",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Passkey",
      "lastName": "Test",
      "email": "passkey@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "correct-horse-battery-staple",
          "temporary": false
        },
        {
          "type": "webauthn",
          "userLabel": "Software test credential",
          "secretData": "{}",
          "credentialData": "{\"aaguid\":\"00000000-0000-0000-0000-000000000000\",\"credentialId\":\"AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8\",\"counter\":0,\"attestationStatement\":\"oA\",\"credentialPublicKey\":\"pQECAyYgASFYIGsX0fLhLEJH-Lzm5WOkQPJ3A32BLeszoPShOUXYmMKWIlggT-NC4v4af5uO5-tKfA-eFivOM1drMV7Oy7ZAaDe_UfU\",\"attestationStatementFormat\":\"none\",\"transports\":[]}"
